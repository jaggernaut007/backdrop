# Backdrop — environment.
# Local dev: copy this file to `.env.local` (gitignored) and fill in
#   the real values. The npm scripts load `.env.local` automatically via
#   `node --env-file-if-exists=.env.local` (start / dev / migrate).
# Deploy (Railway): set these as service Variables — there is no .env file in the container.

# --- Deploy & tooling tokens (NOT read by the app — Railway CLI / Slack tooling only) ---
RAILWAY_TOKEN=00000000-0000-0000-0000-000000000000   # railway.app → Account → Tokens
SLACK_TOKEN=xoxe.xoxp-xxxxx           # Slack app-config token (from Slack app settings) — manifest tooling only

# --- Luma (generation) -----------------------------------------------------
# Get a key at lumalabs.ai; API docs: https://docs.agents.lumalabs.ai
LUMA_AGENTS_API_KEY=luma-api-xxxxx
# LUMA_BASE_URL=https://agents.lumalabs.ai/v1        # override only for testing
# Transient-error retry (429 RPM/concurrent, 502, 503) — ADR 0016. Defaults shown.
# LUMA_MAX_RETRIES=5                                 # retries after the first try; 0 disables
# LUMA_RETRY_BASE_MS=1000                            # nth retry waits base*2^n ms + 0-1s jitter
# LUMA_RETRY_MAX_DELAY_MS=30000                      # cap on the exponential branch; Retry-After still wins

# --- Slack (Socket Mode — see slack-app-manifest.yaml) --------------------
SLACK_BOT_TOKEN=xoxb-xxxxx           # Install App → Bot User OAuth Token
SLACK_APP_TOKEN=xapp-xxxxx           # App-Level Token, scope connections:write
SLACK_CHANNEL_ID=C0XXXXXXX           # the channel the bot watches (bot must be invited)
APPROVER_SLACK_USER_ID=U0XXXXXXX        # binding approver when OPEN_APPROVAL=false (docs/DECISIONS.md A2)
ESCALATION_SLACK_USER_ID=U0YYYYYYY         # stale-escalation @-mention target
# OPEN_APPROVAL=true            # DEFAULT true: ANY channel member can tap
                                     #   Approve/Reject and their own id is recorded as the actor.
                                     #   Set to false to gate approval to APPROVER_SLACK_USER_ID only
                                     #   (docs/DECISIONS.md A2).
# No signing secret — Socket Mode has no inbound HTTP.

# --- Runtime + Storage --------------------------------------------------
# NODE_ENV=production                # set by the Dockerfile / Railway; defaults to "development"
PORT=8080                            # Railway injects this
DATA_DIR=/app/data                   # SQLite file (Railway volume; images moved to R2 via ADR 0017)
PUBLIC_BASE_URL=https://your-app.up.railway.app   # origin for /healthz
# IMAGE_STORE — "volume" (Railway disk, zero-config local dev) or "r2" (Cloudflare R2).
#   The shipped deploy uses r2; its settings live in the Cloudflare R2 block at the
#   bottom of this file. For local dev set IMAGE_STORE=volume and ignore that block.

# --- Pipeline parameters (ASSUMPTIONS.md Part C — all overridable) --------
STALE_THRESHOLD_DAYS=3
FINALS_PER_DIRECTION=2               # auto-generated & auto-published per approved direction (ADR 0020)
DRAFT_COST_CENTS=5                   # uni-1 image_edit ≈ $0.0434, rounded up; logged per attempt
FINAL_COST_CENTS=11                  # uni-1-max image_edit ≈ $0.1030, rounded up
POLL_INTERVAL_MS=3000
STALE_SWEEP_INTERVAL_MS=3600000
# MAX_IN_FLIGHT_GENERATIONS=4        # concurrent Luma jobs cap
# MAX_DRAFTS_PER_TICK=2             # new Drafts started per poll tick
# MAX_FINALS_STARTS_PER_TICK=1     # Finals batches started per poll tick

# --- Cloudflare R2 (ADR 0017) — image store; required when IMAGE_STORE=r2 -
CLOUDFLARE_API_TOKEN=cfat_xxxxx       # Cloudflare API token (R2 admin; deploy tooling)
IMAGE_STORE=r2                        # set "volume" for zero-config local dev
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://accountId.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev   # custom domain for prod (ADR 0017 "r2.dev Rate Limits")
R2_ACCESS_KEY_ID=xxxxx
R2_SECRET_ACCESS_KEY=xxxxx